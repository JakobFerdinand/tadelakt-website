{
  "name": "tadelakt-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run images && next dev",
    "images": "node scripts/generate-thumbnails.mjs",
    "build": "npm run images && next build && node scripts/finalize-export.mjs",
    "start": "node scripts/serve-export.mjs",
    "lint": "biome check .",
    "biome": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "check": "npm run biome && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "classnames": "2.5.1",
    "include-media": "2.0.0",
    "next": "16.3.8",
    "next-seo": "7.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sass": "1.105.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0"
}
